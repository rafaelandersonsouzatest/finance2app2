rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuário só pode ler/escrever o próprio documento de perfil
    // (users/{userId}) e tudo dentro dele: gastos, entradas, emprestimos,
    // cartoes, investimentos, modelosDeGasto, modelosDeEntrada.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Reserva de CPF/CNPJ usada no cadastro para checar duplicidade sem
    // precisar consultar a coleção inteira de usuários (o que a regra acima
    // não permite). O documento não guarda nenhum dado pessoal — só existe
    // para responder "esse CPF/CNPJ já tem conta?" antes de criar qualquer
    // coisa. "get" (documento específico, ID já conhecido) é liberado mesmo
    // sem login, porque a checagem acontece antes da conta existir; "list"
    // (consultar a coleção inteira) não é liberado em nenhum lugar, então não
    // é possível descobrir CPFs que não sejam informados de antemão.
    match /documentosCadastrados/{docId} {
      allow get: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Código de conexão entre usuários (Colaboração — Etapa 2 de
    // COLABORACAO_ARQUITETURA_V1.md). Existe só para permitir "dado um código
    // conhecido, qual é o uid do dono", sem dar acesso de leitura a nenhum
    // perfil — mesmo padrão de documentosCadastrados acima. Diferente dali,
    // aqui exige login: o código só é consultado depois que A já está
    // autenticado no app (não faz parte do fluxo de cadastro). "get" liberado
    // para qualquer autenticado; "list" nunca, então não dá para descobrir
    // códigos de outras pessoas sem já conhecê-los. Criação só do próprio
    // dono, com o formato exato esperado (sem campos extras); depois de
    // criado, o código é permanente — sem update/delete.
    match /codigosConexao/{codigo} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid']);
      allow update, delete: if false;
    }

    // O caminho tenants/{tenantId} já existe no código (getBasePath) para o
    // futuro Modo Família, mas não é usado hoje em nenhum fluxo do app.
    // Fica bloqueado por padrão até essa fase ser implementada com regras
    // próprias de acesso por membro do tenant.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
