{
  "name": "meu-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:dev": "cross-env APP_ENV=meu-app expo start",
    "start:rafael": "cross-env APP_ENV=rafael expo start",
    "start:marina": "cross-env APP_ENV=marina expo start",
    "start:christian": "cross-env APP_ENV=christian expo start",
    "publish:dev": "cross-env APP_ENV=meu-app eas update --branch dev --message \"Atualização DEV\"",
    "publish:rafael": "cross-env APP_ENV=rafael eas update --branch rafael --message \"Versão Rafael atualizada\"",
    "publish:marina": "cross-env APP_ENV=marina eas update --branch marina --message \"Versão Marina atualizada\"",
    "publish:christian": "cross-env APP_ENV=christian eas update --branch christian --message \"Versão Christian atualizada\""
  },
  "dependencies": {
    "@dicebear/core": "^10.3.2",
    "@dicebear/styles": "^10.2.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.4.5",
    "@react-navigation/material-top-tabs": "^7.3.7",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "date-fns": "^4.1.0",
    "expo": "^57.0.24",
    "expo-auth-session": "~57.0.12",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1314.0",
